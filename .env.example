# Supabase
# Config manual en el dashboard (Authentication → URL Configuration) para que
# funcione el reseteo de contraseña por mail:
#   Site URL      = https://www.tribbu.ar/app
#   Redirect URLs = https://www.tribbu.ar/app  y  https://www.tribbu.ar/app/**
# Sin eso, Supabase ignora el redirectTo y el link del mail cae a un Site URL
# viejo (era http://localhost:3000). Ver specs/recuperacion-de-contrasena-por-email.md
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_tu-clave
